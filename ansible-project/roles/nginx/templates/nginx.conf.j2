server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name {{ ansible_hostname }};

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
